# System files
.DS_Store
*~
*.swp
*.swo
.*.swp

# Vim temporary files
*.un~
.netrwhist

# Directory-specific ignores
.cache/
.local/share/recently-used.xbel

# Compiled binaries (except the ones we want to keep)
*.o
*.so
*.a

# Logs
*.log

# Sensitive data
*secret*
*password*
*token*
*.pem
*.key
!home-scripts/.secrets.template

# Local configuration overrides (personal URLs, settings)
*.local.conf

# Application data (not config files - contains sensitive user data)
signal/
sunshine/
retroarch/

# Large binaries (installed by scripts, not tracked)
bin/.local/bin/lazygit
bin/.local/bin/sunsama

# Build artifacts
target/
*.o
*.a
*.so

# Obsbot is cloned/built by install script, don't track source
obsbot/.local/src/

# Hermes personal data: agent memories, personal state, and runtime workspace
# stay local. This repo is public.
hermes/.hermes/memories/
hermes/.hermes/skills/gaming-companion/references/state.md
hermes/.hermes/workspace/*
!hermes/.hermes/workspace/.gitkeep

# Personal Hermes identity and life skills: kept local, never in this public repo
hermes/.hermes/SOUL.md
hermes/.hermes/skills/personal-briefing/
hermes/.hermes/skills/gaming-companion/
